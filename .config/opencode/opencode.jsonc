{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    // MCP-браузер — канал, использованный в инциденте.
    // Замени "playwright*" на точное имя тула, когда найдёшь его
    // через opencode export/stats (см. предыдущий ответ).
    "playwright_*": "ask",
    "playwright_browser_run_code_unsafe": "deny",
    // webfetch в этой версии принимает только плоское значение,
    // без granular-паттернов по URL.
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "rm -rf *": "deny",
      "mkfs *": "deny",
      "dd *": "deny"
    }
  }
}
